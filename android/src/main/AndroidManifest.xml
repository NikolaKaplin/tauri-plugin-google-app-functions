<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <!--
          The schema asset is written into the app module by tauri-plugin-google-app-functions-build;
          its path must match SCHEMA_ASSET in crates/build/src/android.rs.
        -->
        <service
            android:name="com.plugin.google_app_functions.TauriAppFunctionService"
            android:exported="true"
            android:permission="android.permission.BIND_APP_FUNCTION_SERVICE"
            tools:targetApi="36">
            <property
                android:name="android.app.appfunctions.schema"
                android:value="app_functions_schema.xsd" />
            <property
                android:name="android.app.appfunctions.v2"
                android:value="generated/tauri_app_functions.xml" />
            <intent-filter>
                <action android:name="android.app.appfunctions.AppFunctionService" />
            </intent-filter>
        </service>

        <!-- Overridden by the app module when Builder::app_description is set. -->
        <property
            android:name="android.app.appfunctions.app_metadata"
            android:resource="@xml/tauri_app_functions_metadata" />
    </application>
</manifest>
